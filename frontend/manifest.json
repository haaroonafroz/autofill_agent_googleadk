{
  "manifest_version": 3,
  "name": "Autofill Agent",
  "version": "2.0",
  "description": "AI agent that fills job applications from your CV, with you in the loop.",
  "permissions": [
    "sidePanel",
    "scripting",
    "activeTab",
    "tabs",
    "storage",
    "debugger",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Autofill Agent"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
